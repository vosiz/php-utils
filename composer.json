{
    "name": "vosiz/php-utils",
    "description": "A PHP utilities library",
    "type": "library",
    "license": "MIT",
    "keywords": ["utils", "utilities", "helpers", "collection", "dictionary", "exceptions", "io", "path", "csharp-style"],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Vosiz\\Utils\\": "src/"
        },
        "files": [ 
            "src/convert.php",
            "src/functions.php",
            "src/interfaces/icomp.php",
            "src/interfaces/itostring.php",
            "src/guid.php",
            "src/keyval.php",
            "src/exc.php",
            "src/object.php",
            "src/collections/exc.php",
            "src/io/path.php",
            "src/io/file.php",
            "src/io/dir.php",
            "src/io/inc.php",
            "src/collections/collection.php",
            "src/collections/dic.php",
            "src/singleton.php",
            "src/compare.php",
            "src/crypto/pass.php",
            "src/time.php"
        ]
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
